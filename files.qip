set_global_assignment -name SDC_FILE Metro.sdc
# Metro core file list. `source`d by Metro.qsf, so paths are plain and relative to the project directory (the repository root).
# Only real .qip files (loaded via QIP_FILE) may use $::quartus(qip_path).

set_global_assignment -name SYSTEMVERILOG_FILE Metro.sv
set_global_assignment -name QIP_FILE rtl/pll.qip

# the machine
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_cen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_romif.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_ddr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_fastload.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_vout.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_standby.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_crtadj.sv
set_global_assignment -name SYSTEMVERILOG_FILE modules/crt_adjust/crt_adjust.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_eeprom.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_es8712.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_okimux.sv
# the YMF278B (OPL4) of family C: Mouse Shooter GoGo, Bal Cube, Daitoride (YMF278B version).  rtl/ymf278b*.sv = srg320's engine (Arcade-PsikyoSH2_MiSTer, derived from MAME's ymf278b)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ymf278b_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ymf278b.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_ymf.sv

# the Imagetek video chip (derived from searchsolved/Arcade-HyperDuel_MiSTer, GPL-3.0-or-later; rtl/UPSTREAM.md)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_vdp.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_roz.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_render.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_blitter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_tdpram.sv

# fx68k 68000 (GPL-3, Jorge Cwik); microrom.mem / nanorom.mem are read from the project directory
set_global_assignment -name SYSTEMVERILOG_FILE modules/cpu-fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE modules/cpu-fx68k/uaddrPla.sv
set_global_assignment -name SYSTEMVERILOG_FILE modules/cpu-fx68k/fx68k.sv

# the sound board: uPD78C10 (the handlers in rtl/upd78c10_ops.svh etc. are generated from MAME's code by sim/upd78c10/gen_rtl.py and `include`d),
# its glue with a YM2413 and an OKI M6295, and the arbiter that shares the main-ROM client of the SDRAM controller
set_global_assignment -name SEARCH_PATH rtl
set_global_assignment -name SYSTEMVERILOG_FILE rtl/upd78c10.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_sound.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/metro_mrom_arb.sv

