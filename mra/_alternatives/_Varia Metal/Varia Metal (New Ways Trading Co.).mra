<misterromdescription>
    <rotation>vertical</rotation>
    <name>Varia Metal (New Ways Trading Co.)</name>
    <setname>vmetaln</setname>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Excellent System (New Ways Trading Co. license)</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>metro</rbf>
    <platform>Metro</platform>

    <!--
      Flat image for the Metro core (uPD7810 families), the same layout for every set (tools/metro_rom.py):
        0x000000  0x000020  configuration: [0] board [1] rotation [2] GFX scramble (0 none, 1 init_dharmak, 2 init_balcube) [3:6] GFX size
        0x100000  0x800000  gfx (the set's vdp / vdp2 region)
        0x900000  0x100000  maincpu
        0xA00000  0x080000  oki
        0xA80000  0x200000  es

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      The ROMs are stored as dumped; the core applies the driver's GFX descramble (configuration byte 2).
      DIP switches (ioctl index 254): byte 0 is MAME's DSW0 bits 0-7, byte 1 bits 8-15; the boards with a second port (DSW1) have it in bytes 2 and 3; a 1 is MAME's default setting.
    -->
    <switches default="FF,00,FF,00" base="16">
        <dip bits="0,1,2" name="Coinage" ids="1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip bits="3" name="Unused" ids="On,Off"/>
        <dip bits="4" name="Flip Screen" ids="On,Off"/>
        <dip bits="5" name="Demo Sounds" ids="Off,On"/>
        <dip bits="6" name="Unused" ids="On,Off"/>
        <dip bits="7" name="Unused" ids="On,Off"/>
        <dip bits="16,17" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
        <dip bits="18,19" name="Lives" ids="4,2,1,3"/>
        <dip bits="20" name="Bonus Life" ids="Every 60000,Every 30000"/>
        <dip bits="21" name="Unused" ids="On,Off"/>
        <dip bits="22" name="Unused" ids="On,Off"/>
        <dip bits="23" name="Service Mode" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin,Button 3" default="A,B,Start,Select,X"/>

    <rom index="0" zip="vmetaln.zip|vmetal.zip" md5="None" address="0x32000000">

        <!-- configuration -->
        <part>11 01 00 00 00 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>

        <!-- unused -->
        <part repeat="0xFFFE0">00</part>

        <!-- gfx -->
        <interleave output="64">
            <part name="2.u31" crc="b36f8d60" map="00000021"/>
            <part name="4.u30" crc="5a25a49c" map="00002100"/>
            <part name="1.u29" crc="b470c168" map="00210000"/>
            <part name="3.u28" crc="00fca765" map="21000000"/>
        </interleave>

        <!-- maincpu -->
        <interleave output="16">
            <part name="vm6.bin" crc="cb292ab1" map="01"/>
            <part name="vm5.bin" crc="43ef844e" map="10"/>
        </interleave>

        <!-- oki -->
        <part name="8.u9" crc="c14c001c"/>

        <!-- es -->
        <part name="7.u12" crc="a88c52f1"/>
    </rom>
</misterromdescription>
