<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Mahjong Gakuensai (Japan, set 2)</name>
    <setname>gakusaia</setname>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>MakeSoft</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>metrod64</rbf>
    <platform>Metro</platform>

    <!--
      Flat image for the Metro core (uPD7810 families), the same layout for every set (tools/metro_rom.py):
        0x000000  0x000020  configuration: [0] board [1] rotation [2] GFX scramble (0 none, 1 init_dharmak, 2 init_balcube) [3:6] GFX size
        0x010000  0x080000  maincpu
        0x100000  0x2000000  gfx (the set's vdp / vdp2 region)
        0x2100000  0x400000  oki

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      The ROMs are stored as dumped; the core applies the driver's GFX descramble (configuration byte 2).
      DIP switches (ioctl index 254): byte 0 is MAME's DSW0 bits 0-7, byte 1 bits 8-15; the boards with a second port (DSW1) have it in bytes 2 and 3; a 1 is MAME's default setting.
    -->
    <switches default="00,00" base="16">
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin,Button 3" default="A,B,Start,Select,X"/>

    <rom index="0" zip="gakusaia.zip|gakusai.zip" md5="None">

        <!-- configuration -->
        <part>14 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>

        <!-- unused -->
        <part repeat="0xFFE0">00</part>

        <!-- maincpu -->
        <interleave output="16">
            <part name="6.u38" crc="16155d87" map="01"/>
            <part name="5.u39" crc="2564acb8" map="10"/>
        </interleave>

        <!-- unused -->
        <part repeat="0x70000">00</part>

        <!-- gfx -->
        <interleave output="64">
            <part name="2l.u26" crc="45dfb5c7" map="00000021"/>
            <part name="4l.u27" crc="7ab64f49" map="00002100"/>
            <part name="1l.u24" crc="75093421" map="00210000"/>
            <part name="3l.u25" crc="4dcfcd98" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="2u.u21" crc="8d4f912b" map="00000021"/>
            <part name="4u.u20" crc="1f83e98a" map="00002100"/>
            <part name="1u.u23" crc="28b386d9" map="00210000"/>
            <part name="3u.u22" crc="87f3c5e6" map="21000000"/>
        </interleave>

        <!-- oki -->
        <part name="7.u11" crc="34575a14"/>
    </rom>
</misterromdescription>
