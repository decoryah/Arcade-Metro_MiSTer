<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Pang Pom's</name>
    <setname>pangpoms</setname>
    <mameversion>0289</mameversion>
    <year>1992</year>
    <manufacturer>Metro</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>metro</rbf>
    <platform>Metro</platform>

    <!--
      Flat image for the Metro core (uPD7810 families), the same layout for every set (tools/metro_rom.py):
        0x000000  0x000020  configuration: [0] board [1] rotation [2] GFX scramble (0 none, 1 init_dharmak, 2 init_balcube) [3:6] GFX size
        0x010000  0x080000  maincpu
        0x090000  0x020000  audiocpu
        0x0B0000  0x040000  oki
        0x100000  0x400000  gfx (the set's vdp / vdp2 region)

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      The ROMs are stored as dumped; the core applies the driver's GFX descramble (configuration byte 2).
      DIP switches (ioctl index 254): byte 0 is MAME's DSW0 bits 0-7, byte 1 bits 8-15; the boards with a second port (DSW1) have it in bytes 2 and 3; a 1 is MAME's default setting.
    -->
    <switches default="FF,00,EF,00" base="16">
        <dip bits="0,1,2" name="Coin A" ids="Free Play,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="3,4,5" name="Coin B" ids="Free Play,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="6" name="Flip Screen" ids="On,Off"/>
        <dip bits="7" name="Service Mode" ids="On,Off"/>
        <dip bits="16,17" name="Time Speed" ids="Slowest,Slow,Fast,Normal"/>
        <dip bits="18,19" name="Lives" ids="4,2,1,3"/>
        <dip bits="20,21" name="Bonus Life" ids="None,800k,400k and 800k,400k"/>
        <dip bits="22" name="Allow Continue" ids="No,Yes"/>
        <dip bits="23" name="Demo Sounds" ids="Off,On"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin,Button 3" default="A,B,Start,Select,X"/>

    <rom index="0" zip="pangpoms.zip" md5="None">

        <!-- configuration -->
        <part>08 00 00 00 00 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>

        <!-- unused -->
        <part repeat="0xFFE0">00</part>

        <!-- maincpu -->
        <interleave output="16">
            <part name="ppoms09.9.f7" crc="0c292dbc" map="01"/>
            <part name="ppoms10.10.f8" crc="0bc18853" map="10"/>
        </interleave>
        <part repeat="0x40000">00</part>

        <!-- audiocpu -->
        <part name="pj_a12.12.a7" crc="a749357b"/>

        <!-- oki -->
        <part name="pj_a11.11.e1" crc="e89bd565"/>
        <part repeat="0x20000">00</part>

        <!-- unused -->
        <part repeat="0x10000">00</part>

        <!-- gfx -->
        <interleave output="64">
            <part name="pj_e_02.i7" crc="88f902f7" map="00000001"/>
            <part name="ppoms04.bin" crc="9190c2a0" map="00000010"/>
            <part name="ppoms06.bin" crc="ed15c93d" map="00000100"/>
            <part name="pj_e_08.i16" crc="9a3408b9" map="00001000"/>
            <part name="pj_e_01.i6" crc="11ac3810" map="00010000"/>
            <part name="ppoms03.bin" crc="e595529e" map="00100000"/>
            <part name="ppoms05.bin" crc="02226214" map="01000000"/>
            <part name="pj_e_07.i14" crc="48471c87" map="10000000"/>
        </interleave>
        <part repeat="0x300000">00</part>
    </rom>
</misterromdescription>
