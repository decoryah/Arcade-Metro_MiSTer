<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Poitto! (Japan revision D)</name>
    <setname>poitto</setname>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Metro / Able Corp.</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>metro</rbf>
    <platform>Metro</platform>

    <!--
      Flat image for the Metro core (uPD7810 families), the same layout for every set (tools/metro_rom.py):
        0x000000  0x000020  configuration: [0] board [1] rotation [2] GFX scramble (0 none, 1 init_dharmak, 2 init_balcube) [3:6] GFX size
        0x010000  0x080000  maincpu
        0x090000  0x020000  audiocpu
        0x0B0000  0x040000  oki
        0x100000  0x400000  gfx (the set's vdp / vdp2 region)

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      The ROMs are stored as dumped; the core applies the driver's GFX descramble (configuration byte 2).
      DIP switches (ioctl index 254): byte 0 is MAME's DSW0 bits 0-7, byte 1 bits 8-15; the boards with a second port (DSW1) have it in bytes 2 and 3; a 1 is MAME's default setting.
    -->
    <switches default="FF,FF" base="16">
        <dip bits="0,2" name="Coin A" ids="Free Play,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="3,5" name="Coin B" ids="Free Play,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="6" name="Flip Screen" ids="On,Off"/>
        <dip bits="7" name="Service Mode" ids="On,Off"/>
        <dip bits="8,9" name="Difficulty" ids="Easy,Hardest,Hard,Normal"/>
        <dip bits="10" name="Unused" ids="On,Off"/>
        <dip bits="11" name="Unused" ids="On,Off"/>
        <dip bits="12" name="Unused" ids="On,Off"/>
        <dip bits="13" name="Allow Continue" ids="No,Yes"/>
        <dip bits="14" name="Demo Sounds" ids="Off,On"/>
        <dip bits="15" name="Unused" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,-,Start,Coin,-" default="A,B,Start,Select,X"/>

    <rom index="0" zip="poitto.zip" md5="None" address="0x32000000">

        <!-- configuration -->
        <part>0C 00 00 00 00 20 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>

        <!-- unused -->
        <part repeat="0xFFE0">00</part>

        <!-- maincpu -->
        <interleave output="16">
            <part name="pt-jd05.20e" crc="6b1be034" map="01"/>
            <part name="pt-jd06.20c" crc="3092d9d4" map="10"/>
        </interleave>
        <part repeat="0x40000">00</part>

        <!-- audiocpu -->
        <part name="pt-jc08.3i" crc="f32d386a"/>

        <!-- oki -->
        <part name="pt-jc07.3g" crc="5ae28b8d"/>

        <!-- unused -->
        <part repeat="0x10000">00</part>

        <!-- gfx -->
        <interleave output="64">
            <part name="pt-2.15i" crc="05d15d01" map="00000021"/>
            <part name="pt-4.19i" crc="8a39edb5" map="00002100"/>
            <part name="pt-1.13i" crc="ea6e2289" map="00210000"/>
            <part name="pt-3.17i" crc="522917c1" map="21000000"/>
        </interleave>
        <part repeat="0x200000">00</part>
    </rom>
</misterromdescription>
